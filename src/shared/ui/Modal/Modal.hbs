<div class="modal-overlay">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal__title">{{title}}</h3>
            <button class="modal__close" type="button">&times;</button>
        </div>
        <div class="modal-body">
            <p class="modal-text">{{text}}</p>
        </div>
        <div class="modal__buttons"></div>
        </div>
    </div>
</div>