<div class="board-card {{#if archived}}board-card--archived{{/if}}" data-board-id="{{id}}">
    {{#if archived}}
    <button class="board-card__menu-button" type="button" aria-label="Действия">
        <img src="images/menu-icon.svg" alt="Меню">
    </button>
    {{/if}}
    <div class="board-card__image">
        <img src="{{image}}" alt="{{title}}">
    </div>
    <div class="board-card__content">
        <h3 class="board-card__title">{{title}}</h3>
    </div>
</div>